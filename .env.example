# Copy this file to .env and fill in ONE key. .env is git-ignored; keys stay on this computer and are never
# sent to the web page.

# Muse Spark Open on Baseten: the judge Lost & Frame was tested with (RESEARCH.md, sealed tests).
BASETEN_API_KEY=

# Or the Meta Model API (Muse Spark 1.3). It works the same way and was tested in its own sealed runs (README).
MODEL_API_KEY=

# Optional, precision mode only: the Python of a venv with PyTorch (CUDA) and SAM 3.1 (README).
# PYTHON=C:/path/to/venv/Scripts/python.exe
